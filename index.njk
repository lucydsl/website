<div class="hero container">
  <header class="description">
    <h1 class="title">🧛🏻‍♀️ Lucy <span class="subtitle">language</span></h1>
    <h2 class="subtitle">A concise language for describing <a href="https://brilliant.org/wiki/finite-state-machines/">Finite State Machines</a>.</h2>

    <dl>
      <dt>Expressive</dt>
      <dd>Complex sets of events, guards, actions, and destination states can be expressed in a single line. Nesting machines gives you a hierarchical machine.</dd>
      <dt>Plain JavaScript</dt>
      <dd>Lucy compiles each machine to a small, readable JavaScript module with no dependencies and no runtime library. What runs is a handful of ordinary functions, so the code you ship is tiny and stack traces stay shallow.</dd>
      <dt>Fast</dt>
      <dd>Lucy is written in C, so compiling is quick: <code>lucyc</code> is a native command-line compiler, and the same compiler is built to <a href="https://webassembly.org/">WebAssembly</a> for easy use in JavaScript projects. At run time, sending an event is a lookup and a function call.</dd>
    </dl>
  </header>

  <section class="example">
    <h1>toggle.lucy</h1>

    {% highlight "lucy" %}
state enabled {
  toggle => disabled
}

initial state disabled {
  toggle => enabled
}
    {% endhighlight %}

    <h1>out.js</h1>
    {% highlight "js" %}
export default function createMachine({ context = {} } = {}) {
  const listeners = new Set();
  const states = {
    enabled: {
      toggle() {
        machine.state = 'disabled';
      }
    },
    disabled: {
      toggle() {
        machine.state = 'enabled';
      }
    }
  };
  function notify() {
    for(const listener of listeners) {
      listener(machine);
    }
  }
  const machine = {
    state: 'disabled',
    context,
    send(event) {
      if(typeof event === 'string') {
        event = { type: event };
      }
      const handler = states[machine.state][event.type];
      if(handler) {
        handler(event);
        notify();
      }
    },
    subscribe(listener) {
      listeners.add(listener);
      return () => listeners.delete(listener);
    },
    start() {
      notify();
      return machine;
    },
    stop() {
      listeners.clear();
    }
  };
  return machine;
}
    {% endhighlight %}
