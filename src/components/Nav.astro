---
import { isDocs } from '../site.ts';

// The site's header: the initial pseudostate (a dot and an arrow) leading
// into "Lucy", and the other pages drawn as states, the current one filled.
const { pathname } = Astro.url;
const states = [
  { name: 'install', href: 'install/', active: pathname === '/install/' },
  { name: 'docs', href: 'docs/', active: isDocs(pathname) },
  { name: 'github', href: 'https://github.com/lucydsl/liblucy', active: false },
];
---
<header class="site-head">
  <a href="./" class="site-head__brand" aria-current={pathname === '/' ? 'page' : undefined}>
    <svg class="site-head__initial" viewBox="0 0 34 12" width="34" height="12" aria-hidden="true">
      <circle cx="5" cy="6" r="5" />
      <path d="M10 6h20M25 1.5 30.5 6 25 10.5" />
    </svg>
    <span class="site-head__name">Lucy</span>
  </a>
  <nav class="site-nav" aria-label="Main">
    <ul class="site-nav__list">
      {states.map((state) => (
        <li class="site-nav__item">
          <a
            href={state.href}
            class:list={['site-nav__state', { 'site-nav__state--active': state.active }]}
            aria-current={state.active ? 'page' : undefined}
          >{state.name}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
