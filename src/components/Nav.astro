---
const { pathname } = Astro.url;
---
<nav class="site-nav">
  <ul class="site-nav__list">
    <li class:list={['site-nav__item', { 'site-nav__item--active': pathname === '/install/' }]}>
      <a href="install/" class="site-nav__link">Install</a>
    </li>
    <li class:list={['site-nav__item', { 'site-nav__item--active': pathname.startsWith('/docs') }]}>
      <a href="docs/" class="site-nav__link">Docs</a>
    </li>
    <li class="site-nav__item">
      <a href="https://github.com/lucydsl/liblucy" class="site-nav__link">GitHub</a>
    </li>
  </ul>
</nav>
