---
const { pathname } = Astro.url;
---
<nav class="site-nav">
  <ul>
    <li class:list={{ active: pathname === '/install/' }}>
      <a href="install/">Install</a>
    </li>
    <li class:list={{ active: pathname.startsWith('/docs') }}>
      <a href="docs/">Docs</a>
    </li>
    <li>
      <a href="https://github.com/lucydsl/liblucy">GitHub</a>
    </li>
  </ul>
</nav>
