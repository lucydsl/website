---
// Content pages: the page header, then the content running down the rail.
// Markdown pages get the prose styles; pass prose={false} for hand-written
// markup with its own classes, and list its stylesheets in `styles`.
import Site from './Site.astro';
import PageHead from '../components/PageHead.astro';

const { frontmatter, base, prose = true, styles } = Astro.props;
---
<Site title={frontmatter.title + ' | Lucy'} description={frontmatter.lede} base={base} styles={styles}>
  <div class="rail">
    <PageHead title={frontmatter.title} lede={frontmatter.lede} state={frontmatter.state} />
    <div class:list={['rail__content', { prose }]}>
      <slot />
    </div>
  </div>
</Site>
