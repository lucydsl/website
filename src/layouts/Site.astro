---
// The document shell every page shares: head, the site header and the
// final-state footer. Pages put their content in the slot, inside <main>.
import Base from '../components/Base.astro';
import BaseStyles from '../components/BaseStyles.astro';
import Footer from '../components/Footer.astro';
import Icons from '../components/Icons.astro';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  description?: string;
  base?: string;
  styles?: string[];
}

const { title, description, base, styles = [] } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
{description && <meta name="description" content={description}>}
<meta name="theme-color" content="#181a22">
<Base href={base} />
<BaseStyles />
{styles.map((sheet) => <link rel="stylesheet" href={`styles/${sheet}.css`}>)}
<Icons />
</head>
<body>
<a href="#main" class="skip-link">Skip to content</a>
<Nav />
<main id="main" class="site-main">
<slot />
</main>
<Footer />
</body>
</html>
