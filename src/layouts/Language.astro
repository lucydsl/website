---
// The language guide: the rail and the guide, with its contents beside it
// (from lg up) or folded above it (below lg). The contents are drawn as a
// statechart: each section a state, with its subsections nested inside.
import Site from './Site.astro';
import Statechart from '../components/Statechart.astro';
import PageHead from '../components/PageHead.astro';
import { fromBase } from '../site.ts';

// `sections` in the frontmatter lists the contents: a string is a link to a
// section, and a one-key object is a section with its subsections.
type Section = string | Record<string, string[]>;

const { frontmatter } = Astro.props;
const sections = (frontmatter.sections as Section[]).map((section) => {
  if (typeof section === 'string') return { title: section, items: [] as string[] };
  const [title] = Object.keys(section);
  return { title, items: section[title] };
});
const page = fromBase(Astro.url.pathname);
const hashLink = (title: string) => page + '#' + title.toLowerCase().replace(/ /g, '-');
const contents = sections.map(({ title, items }) => ({
  title,
  href: hashLink(title),
  items: items.map((item) => ({ title: item, href: hashLink(item) })),
}));
---
<Site title={frontmatter.title + ' | Lucy'} description={frontmatter.lede} styles={['language']}>
  <div class="guide">
    <div class="guide__body rail">
      <PageHead title={frontmatter.title} lede={frontmatter.lede} />

      <details class="guide__fold">
        <summary class="guide__summary">Contents</summary>
        <Statechart sections={contents} />
      </details>

      <div class="rail__content prose">
        <slot />
      </div>
    </div>

    <nav class="guide__aside" aria-label="Guide contents">
      <p class="guide__aside-title">Contents</p>
      <Statechart sections={contents} />
    </nav>
  </div>
</Site>
